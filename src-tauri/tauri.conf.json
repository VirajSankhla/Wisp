{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisp",
  "version": "0.1.0",
  "identifier": "app.wisp.notes",
  "build": {
    "frontendDist": "../native-dist",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "node scripts/prepare-native-dist.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Wisp",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
